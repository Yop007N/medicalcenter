{
  "name": "medical-services",
  "version": "1.0.0",
  "description": "Comprehensive clinical management system with hybrid cloud-local architecture",
  "scripts": {
    "backend:install": "cd backend && pip install -r requirements/dev.txt",
    "backend:start": "cd backend && python run.py",
    "backend:test": "cd backend && pytest",
    "frontend-admin-profesional:install": "cd frontend-admin-profesional && npm install",
    "frontend-admin-profesional:start": "cd frontend-admin-profesional && npm start",
    "frontend-admin-profesional:build": "cd frontend-admin-profesional && npm run build",
    "frontend-admin-profesional:test": "cd frontend-admin-profesional && npm test",
    "frontend-profesional:install": "cd frontend-profesional && npm install",
    "frontend-profesional:start": "cd frontend-profesional && npm start",
    "frontend-profesional:build": "cd frontend-profesional && npm run build",
    "frontend-profesional:test": "cd frontend-profesional && npm test",
    "frontend-paciente:install": "cd frontend-paciente && npm install",
    "frontend-paciente:start": "cd frontend-paciente && ionic serve",
    "frontend-paciente:build": "cd frontend-paciente && npm run ionic:build",
    "frontend-web:install": "npm run frontend-profesional:install",
    "frontend-web:start": "npm run frontend-profesional:start",
    "frontend-web:build": "npm run frontend-profesional:build",
    "frontend-web:test": "npm run frontend-profesional:test",
    "frontend-pwa:install": "npm run frontend-paciente:install",
    "frontend-pwa:start": "npm run frontend-paciente:start",
    "frontend-pwa:build": "npm run frontend-paciente:build",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "install:all": "npm run backend:install && npm run frontend-admin-profesional:install && npm run frontend-profesional:install && npm run frontend-paciente:install"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourorg/medical-services.git"
  },
  "keywords": [
    "medical",
    "healthcare",
    "clinic",
    "appointments",
    "ehr",
    "emr"
  ],
  "author": "Your Name",
  "license": "MIT",
  "private": true
}
