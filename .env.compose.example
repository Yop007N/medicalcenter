# Docker Compose (root) environment variables
# Copy to .env before running docker compose in root.

# PostgreSQL (used by docker-compose.prod.yml)
POSTGRES_DB=medical_services
POSTGRES_USER=medical_user
POSTGRES_PASSWORD=change-me

# Backend secrets
DATABASE_URL=postgresql://medical_user:change-me@postgres:5432/medical_services
JWT_SECRET_KEY=change-me
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:4200,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# pgAdmin (docker-compose.db.yml)
PGADMIN_DEFAULT_EMAIL=admin@medical.local
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin

# Optional host ports for frontend compose stack (docker-compose.yml)
FRONTEND_WEB_PORT=4200
FRONTEND_PWA_PORT=8100

# Optional S3 storage (leave empty if local storage)
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
