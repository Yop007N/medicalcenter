@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor Paciente as C

rectangle "Medical Services - Actor Paciente" {
  usecase "UC-MS-001\nAutenticar usuario" as UC1
  usecase "UC-MS-002\nRegistro publico\n(patient)" as UC2
  usecase "UC-MS-005\nConsultar perfil y\ndatos propios" as UC5
  usecase "UC-MS-006\nSolicitar/cancelar turnos\npropios" as UC6
  usecase "UC-MS-007\nConsultar historial medico\npropio" as UC7
  usecase "UC-MS-009\nConsultar documentos\nclinicos propios" as UC9
  usecase "UC-MS-012\nAceptar presupuestos\npropios" as UC12
  usecase "UC-MS-014\nConsultar panel\npersonal" as UC14
}

C --> UC1
C --> UC2
C --> UC5
C --> UC6
C --> UC7
C --> UC9
C --> UC12
C --> UC14
@enduml
