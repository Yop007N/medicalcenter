@startuml use_case_profesional
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor Profesional as P

rectangle "Medical Services - Actor Profesional" {
  usecase "UC-MS-001\nAutenticar usuario" as UC1
  usecase "UC-MS-002\nRegistro publico\n(professional)" as UC2
  usecase "UC-MS-005\nGestionar pacientes\nasignados" as UC5
  usecase "UC-MS-006\nGestionar agenda y\nconfirmaciones" as UC6
  usecase "UC-MS-007\nGestionar historial medico\n(base)" as UC7
  usecase "UC-MS-008\nHistoria clinica\nodontologica avanzada" as UC8
  usecase "UC-MS-009\nGestionar archivos clinicos" as UC9
  usecase "UC-MS-010\nOdontogramas y\ntratamientos dentales" as UC10
  usecase "UC-MS-011\nPsicologia y\npsicopedagogia" as UC11
  usecase "UC-MS-012\nGestionar presupuestos" as UC12
  usecase "UC-MS-013\nGestionar pagos" as UC13
  usecase "UC-MS-014\nConsultar dashboard" as UC14
  usecase "UC-MS-015\nGenerar reportes" as UC15
  usecase "UC-MS-017\nSincronizar local-nube" as UC17
  usecase "UC-MS-018\nAcceder a modulo de\nespecialidad propio" as UC18
  usecase "UC-MS-019\nGestionar historia clinica\navanzada (anamnesis/\nevolucion/recetas/\nconsentimientos)" as UC19
  usecase "UC-MS-021\nConsultar disponibilidad\npropia (slots)" as UC21
}

P --> UC1
P --> UC2
P --> UC5
P --> UC6
P --> UC7
P --> UC8
P --> UC9
P --> UC10
P --> UC11
P --> UC12
P --> UC13
P --> UC14
P --> UC15
P --> UC17
P --> UC18
P --> UC19
P --> UC21

UC18 .> UC19 : <<include>>
UC8 .> UC19 : <<extend>>
UC10 .> UC19 : <<extend>>
UC11 .> UC19 : <<extend>>
@enduml
