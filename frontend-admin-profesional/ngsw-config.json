{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-auth",
      "urls": [
        "/api/auth/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 10,
        "maxAge": "1h",
        "timeout": "10s"
      }
    },
    {
      "name": "api-patients",
      "urls": [
        "/api/patients/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "5s"
      }
    },
    {
      "name": "api-professionals",
      "urls": [
        "/api/professionals/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 50,
        "maxAge": "1d",
        "timeout": "5s"
      }
    },
    {
      "name": "api-appointments",
      "urls": [
        "/api/appointments/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 200,
        "maxAge": "12h",
        "timeout": "5s"
      }
    },
    {
      "name": "api-medical-records",
      "urls": [
        "/api/medical-records/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 500,
        "maxAge": "1d",
        "timeout": "5s"
      }
    },
    {
      "name": "api-budgets",
      "urls": [
        "/api/budgets/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "5s"
      }
    },
    {
      "name": "api-payments",
      "urls": [
        "/api/payments/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 200,
        "maxAge": "1d",
        "timeout": "5s"
      }
    },
    {
      "name": "api-reports",
      "urls": [
        "/api/reports/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 20,
        "maxAge": "6h",
        "timeout": "10s"
      }
    },
    {
      "name": "api-specialties",
      "urls": [
        "/api/odontology/**",
        "/api/psychology/**",
        "/api/psychopedagogy/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 300,
        "maxAge": "1d",
        "timeout": "5s"
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**"
  ]
}
